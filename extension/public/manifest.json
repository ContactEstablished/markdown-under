{
  "manifest_version": 3,
  "name": "Markdown Under",
  "short_name": "Markdown Under",
  "version": "0.1.0",
  "description": "Renders local and web Markdown files: tables, math, diagrams, code highlighting, outline and live reload.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Markdown Under",
    "default_popup": "options.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "file:///*.md",
        "file:///*.markdown",
        "file:///*.mdx",
        "file:///*.mkd",
        "file:///*.mdown",
        "file:///*.mkdn",
        "file:///*.MD",
        "file:///*.Md"
      ],
      "js": [
        "loader.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "http://*/*.md",
        "https://*/*.md",
        "http://*/*.markdown",
        "https://*/*.markdown",
        "http://*/*.md?*",
        "https://*/*.md?*"
      ],
      "js": [
        "loader.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "viewer.js",
        "assets/*"
      ],
      "matches": [
        "file:///*",
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
